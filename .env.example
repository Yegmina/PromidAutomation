# Copy this file to .env and fill in your own values.

# Login
PROMID_URL=https://metropolia.promid.fi/
PROMID_EMAIL=your.email@metropolia.fi
PROMID_PASSWORD=your-password

# Browser
TZ=Europe/Helsinki
PROMID_HEADLESS=false
PROMID_LOGIN_STATE_PATH=.auth/promid-state.json
PROMID_RUNTIME_STATE_PATH=.auth/promid-runtime-state.json

# Safety defaults
PROMID_DRY_RUN=false

# Daily local-time events. Format: HH:mm=action,HH:mm=action
# Supported actions:
# start = Sisaan / Sign in
# lunch = Lounas / Lunch
# stop = Ulos / Sign out
PROMID_SCHEDULE=06:00=start,09:00=stop,17:00=start,19:00=lunch,19:30=start,22:30=stop

# Days when events are allowed. 0=Sunday, 1=Monday, ... 6=Saturday.
# Default below means Monday-Friday only. Telegram weekly schedules still reject weekends.
PROMID_ACTIVE_DAYS=1,2,3,4,5

# Adds a random whole-minute offset to each scheduled event while the monitor is running.
# Example: 10 means each event happens somewhere between -10 and +10 minutes.
PROMID_TIME_JITTER_MINUTES=10

# Retry delays for transient login/network/unknown-state errors.
# Default means: try now, then retry after 1, 3, and 5 minutes.
PROMID_RETRY_DELAYS_SECONDS=0,60,180,300

# Optional: configure the actual post-login controls after you see Promid's page.
# Text matching is case-insensitive and targets attendance buttons.
PROMID_START_TEXTS=Sisään,Sisaan,Sign in
PROMID_LUNCH_TEXTS=Lounas,Lunch
PROMID_STOP_TEXTS=Ulos,Sign out

# Optional: status text overrides for state detection.
PROMID_WORKING_STATUS_TEXTS=Signed in,Sisäänkirjautunut
PROMID_LUNCH_STATUS_TEXTS=Lunch,Lounas
PROMID_SIGNED_OUT_STATUS_TEXTS=Signed out,Uloskirjautunut

# Optional: CSS selectors override text matching if Promid has stable selectors.
# PROMID_START_SELECTOR=
# PROMID_LUNCH_SELECTOR=
# PROMID_STOP_SELECTOR=

# Telegram bot integration.
# Rotate any exposed token in BotFather and put the new value here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERNAMES=yehorte,yehortere,yehor_a
TELEGRAM_STATE_PATH=.auth/telegram-state.json
TELEGRAM_DRY_RUN=false
